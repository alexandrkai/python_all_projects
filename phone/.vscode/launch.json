    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "DEV",
            "type": "debugpy",
            "request": "launch",
            "module": "main", // Укажите имя вашего модуля
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app", // Также можно указать корень проекта[reference:9]
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "HONOR8X",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py",
            "console": "integratedTerminal",
            "cwd": "/mnt/d/myprogramms/Python/phone",
            "env": {
                "PHONE_NAME": "HONOR8X",
                "PYTHONPATH": "/mnt/d/myprogramms/Python/phone"
            },
            "justMyCode": true
        }
    ]
}