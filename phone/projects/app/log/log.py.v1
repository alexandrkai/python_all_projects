# Позже, чтобы сменить файл
def switch_log_file(new_filename: str):
    """Простая смена файла логов"""
    for handler in logger.handlers[:]:
        if isinstance(handler, logging.FileHandler):
            logger.removeHandler(handler)
            handler.close()
            break
    
    new_handler = logging.FileHandler(new_filename, encoding='utf-8')
    new_handler.setFormatter(logging.Formatter(
        "%(asctime)s | %(levelname)-8s | %(filename)s:%(lineno)d | %(funcName)s | %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S"
    ))
    logger.addHandler(new_handler)

class myErrorTrace:
    def __init__(self,exception):
        self.repr=repr(exception)
        self.exception_type = type(exception).__name__
        self.exception_message = str(exception)
        self.traceback_object = exception.__traceback__
        self.traceAndError=traceback.format_exc()

    def getTrace(self):
        tb=self.traceback_object
        print("Возникла ошибка!!")
        description="\n"
        while tb:
            description+="\n"+f"Файл: {tb.tb_frame.f_code.co_filename}"
            description+="\n"+f"Строка: {tb.tb_lineno}"
            description+="\n"+f"Функция: {tb.tb_frame.f_code.co_name}"
            tb = tb.tb_next
        return description
    
def createLogger(*,filename="app.log",name=__name__):
# Настройка логирования
    logging.basicConfig(
        filename=filename,
        level=logging.INFO,
        format="%(asctime)s | %(levelname)-8s | %(filename)s:%(lineno)d | %(funcName)s | %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
        encoding="utf-8",  # Добавьте эту строку
        force=True  # Полезно, если конфигурация уже была установлена ранее
    )
    logger = logging.getLogger(name) 
    return logger 

def setup_logger(name, log_file, level=logging.INFO):
    """Настройка логгера для конкретного модуля"""
    
    # Создаем логгер
    logger = logging.getLogger(name)
    logger.setLevel(level)
    
    # Проверяем, не добавлены ли уже обработчики
    if logger.handlers:
        return logger
    
    # Создаем директорию для логов, если ее нет
    log_dir = os.path.dirname(log_file)
    if log_dir and not os.path.exists(log_dir):
        os.makedirs(log_dir)
    
    # Форматтер
    formatter = logging.Formatter(
        '%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    
    # Файловый обработчик с ротацией
    file_handler = RotatingFileHandler(
        log_file,
        maxBytes=10*1024*1024,  # 10 MB
        backupCount=5,
        encoding='utf-8'
    )
    file_handler.setFormatter(formatter)
    
    # Консольный обработчик
    console_handler = logging.StreamHandler()
    console_handler.setFormatter(formatter)
    
    # Добавляем обработчики к логгеру
    logger.addHandler(file_handler)
    logger.addHandler(console_handler)
    
    return logger

# Предопределенные логгеры для удобства
def get_main_logger():
    return setup_logger('main', 'logs/main.log')

def get_network_logger():
    return setup_logger('network', 'logs/network.log')

def get_database_logger():
    return setup_logger('database', 'logs/database.log')

def get_api_logger():
    return setup_logger('api', 'logs/api.log')

class MyLogger:
    def __init__(self):
        current_file = Path(__file__).resolve()
        PATH_APPLICATION_FOLDER=current_file.parent.parent
        # Настройка логирования
        logging.basicConfig(
            filename=os.path.join(PATH_APPLICATION_FOLDER,"log","app.log"),
            level=logging.INFO,
            format="%(asctime)s | %(levelname)-8s | %(filename)s:%(lineno)d | %(funcName)s | %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
            encoding="utf-8",  # Добавьте эту строку
            force=True  # Полезно, если конфигурация уже была установлена ранее
        )
        self.logger = logging.getLogger(__name__)
        
    def print_debug(self,message):
        print(message)
        self.logger.debug(message)
    
    def print_info(self,message):
        print(message)
        self.logger.info(message)
    
    def print_warning(self,message):
        print(message)
        self.logger.warning(message)
    
    def print_error(self,message):
        print(message)
        self.logger.error(message)
        
    def print_critical(self,message):
        print(message)
        self.logger.critical(message)
    
    def debug(self,message):
        self.logger.debug(message)
    
    def info(self,message):
        self.logger.info(message)
    
    def warning(self,message):
        self.logger.warning(message)
    
    def error(self,message):
        self.logger.error(message)
        
    def critical(self,message):
        self.logger.critical(message)
        
logger=MyLogger()